# Server Port
PORT=3000

# Google Gemini API Key for Multimodal AI Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Required for connecting to remote Supabase project.
# When not set, the built-in persistent local database engine is used automatically.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Server-side only (NEVER expose to client or prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public Supabase Client (For browser authentication if direct client access is desired)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
